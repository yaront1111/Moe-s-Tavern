{
  "name": "moe-vscode",
  "displayName": "Moe's Tavern",
  "description": "AI agent task board: run Claude Code, Codex, Antigravity and Grok Build through a shared Kanban board with human plan approval",
  "version": "0.8.0",
  "publisher": "yaront1111",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yaront1111/Moe-s-Tavern"
  },
  "homepage": "https://github.com/yaront1111/Moe-s-Tavern#readme",
  "bugs": {
    "url": "https://github.com/yaront1111/Moe-s-Tavern/issues"
  },
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "ai",
    "agent",
    "ai agents",
    "task",
    "task board",
    "kanban",
    "mcp",
    "claude",
    "claude code",
    "codex",
    "gpt"
  ],
  "activationEvents": [
    "workspaceContains:.moe",
    "onCommand:moe.connect",
    "onView:moe.board",
    "onView:moe.chat",
    "onView:moe.metrics"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "moe",
          "title": "Moe",
          "icon": "resources/moe-icon.svg"
        }
      ]
    },
    "views": {
      "moe": [
        {
          "type": "webview",
          "id": "moe.board",
          "name": "Task Board"
        },
        {
          "type": "webview",
          "id": "moe.chat",
          "name": "Chat"
        },
        {
          "type": "webview",
          "id": "moe.metrics",
          "name": "Metrics"
        },
        { "id": "moe.managedVms", "name": "Managed VMs" },
        { "id": "moe.accounts", "name": "Claude accounts" }
      ]
    },
    "commands": [
      {
        "command": "moe.connect",
        "title": "Moe: Connect to Daemon"
      },
      {
        "command": "moe.disconnect",
        "title": "Moe: Disconnect from Daemon"
      },
      {
        "command": "moe.refresh",
        "title": "Moe: Refresh Board"
      },
      {
        "command": "moe.openTaskDetail",
        "title": "Moe: Open Task Detail"
      },
      {
        "command": "moe.reviewPlan",
        "title": "Moe: Review Plan"
      },
      {
        "command": "moe.createTask",
        "title": "Moe: Create Task"
      },
      {
        "command": "moe.createEpic",
        "title": "Moe: Create Epic"
      },
      {
        "command": "moe.openEpicDetail",
        "title": "Moe: Open Epic Detail"
      },
      {
        "command": "moe.archiveDoneTasks",
        "title": "Moe: Archive Done Tasks"
      },
      {
        "command": "moe.showDaemonStatus",
        "title": "Moe: Show Daemon Status"
      },
      {
        "command": "moe.startAgent",
        "title": "Moe: Start Agent"
      },
      {
        "command": "moe.startAllAgents",
        "title": "Moe: Start All Agents"
      },
      {
        "command": "moe.openSettings",
        "title": "Moe: Open Settings"
      },
      {
        "command": "moe.showActivityLog",
        "title": "Moe: Show Activity Log"
      },
      {
        "command": "moe.reconnect",
        "title": "Moe: Reconnect to Daemon"
      },
      { "command": "moe.managedVms.refresh", "title": "Moe: Refresh Managed VMs", "icon": "$(refresh)" },
      { "command": "moe.managedVms.reconcile", "title": "Moe: Reconcile Managed VMs", "icon": "$(sync)", "enablement": "moe.managedVms.canReconcile" },
      { "command": "moe.managedVms.cleanup", "title": "Moe: Clean Up Owned VMs", "icon": "$(trash)", "enablement": "moe.managedVms.canCleanup" },
      { "command": "moe.accounts.refresh", "title": "Moe: Refresh Claude Accounts", "icon": "$(refresh)" },
      { "command": "moe.accounts.add", "title": "Add...", "category": "Moe Accounts", "icon": "$(add)" },
      { "command": "moe.accounts.signIn", "title": "Sign in", "category": "Moe Accounts" },
      { "command": "moe.accounts.remove", "title": "Remove...", "category": "Moe Accounts" },
      { "command": "moe.accounts.moveUp", "title": "Move up", "category": "Moe Accounts" },
      { "command": "moe.accounts.moveDown", "title": "Move down", "category": "Moe Accounts" },
      { "command": "moe.accounts.rename", "title": "Rename...", "category": "Moe Accounts" },
      { "command": "moe.accounts.setSwitchPercent", "title": "Set Switch Percent...", "category": "Moe Accounts", "icon": "$(settings-gear)" }
    ],
    "menus": {
      "view/title": [
        {
          "command": "moe.createTask",
          "when": "view == moe.board",
          "group": "navigation"
        },
        {
          "command": "moe.refresh",
          "when": "view == moe.board",
          "group": "navigation"
        },
        { "command": "moe.managedVms.refresh", "when": "view == moe.managedVms", "group": "navigation@1" },
        { "command": "moe.managedVms.reconcile", "when": "view == moe.managedVms", "group": "navigation@2" },
        { "command": "moe.managedVms.cleanup", "when": "view == moe.managedVms", "group": "navigation@3" },
        { "command": "moe.accounts.refresh", "when": "view == moe.accounts", "group": "navigation@1" },
        { "command": "moe.accounts.add", "when": "view == moe.accounts && moe.accounts.canAdd", "group": "navigation@2" },
        { "command": "moe.accounts.setSwitchPercent", "when": "view == moe.accounts && moe.accounts.canSwitchAt", "group": "navigation@3" }
      ],
      "view/item/context": [
        { "command": "moe.accounts.signIn", "when": "view == moe.accounts && viewItem =~ /\\bcanSignIn\\b/", "group": "1_accounts@1" },
        { "command": "moe.accounts.rename", "when": "view == moe.accounts && viewItem =~ /\\bcanRename\\b/", "group": "1_accounts@2" },
        { "command": "moe.accounts.moveUp", "when": "view == moe.accounts && viewItem =~ /\\bcanMoveUp\\b/", "group": "1_accounts@3" },
        { "command": "moe.accounts.moveDown", "when": "view == moe.accounts && viewItem =~ /\\bcanMoveDown\\b/", "group": "1_accounts@4" },
        { "command": "moe.accounts.remove", "when": "view == moe.accounts && viewItem =~ /\\bcanRemove\\b/", "group": "1_accounts@5" }
      ],
      "commandPalette": [
        { "command": "moe.accounts.add", "when": "false" },
        { "command": "moe.accounts.signIn", "when": "false" },
        { "command": "moe.accounts.remove", "when": "false" },
        { "command": "moe.accounts.moveUp", "when": "false" },
        { "command": "moe.accounts.moveDown", "when": "false" },
        { "command": "moe.accounts.rename", "when": "false" },
        { "command": "moe.accounts.setSwitchPercent", "when": "false" }
      ]
    },
    "configuration": {
      "title": "Moe",
      "properties": {
        "moe.daemon.host": {
          "type": "string",
          "default": "127.0.0.1",
          "description": "Moe daemon host address"
        },
        "moe.daemon.port": {
          "type": "number",
          "default": 0,
          "description": "Moe daemon port (0 = auto-detect from .moe/daemon.json)"
        },
        "moe.daemon.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Automatically start the Moe daemon when needed"
        },
        "moe.autoConnect": {
          "type": "boolean",
          "default": true,
          "description": "Automatically connect to daemon when workspace contains .moe folder, and keep retrying with backoff while no daemon answers"
        },
        "moe.chat.notifications.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show IDE notifications when agent chat messages arrive"
        },
        "moe.chat.notifications.mutedChannels": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "List of channel IDs to mute notifications for"
        }
      }
    },
    "configurationDefaults": {
      "files.watcherExclude": {
        "**/.worktrees/**": true
      },
      "search.exclude": {
        "**/.worktrees": true
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run bundle && npm run esbuild",
    "compile": "tsc -p ./",
    "test": "node --test tests/*.test.cjs",
    "watch": "tsc -watch -p ./",
    "esbuild": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
    "esbuild:watch": "npm run esbuild -- --watch",
    "lint": "eslint src --ext ts",
    "package": "vsce package",
    "publish": "vsce publish",
    "bundle": "node ./scripts/bundle-assets.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/vscode": "^1.140.0",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "dependencies": {
    "ws": "^8.22.0"
  }
}
