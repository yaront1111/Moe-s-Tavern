      "expectDeregistered": ["qa-bbbb2222", "qa-bbbb2222", "worker-aaaa1111", "worker-aaaa1111"],
      "expectPersisted": ["architect-cccc3333"]
    },
    {
      "id": "S11",
      "note": "a restart forgets which seats are open but keeps the deregistration log; a relaunch after it is open again",
      "persisted": [],
      "events": [
        { "op": "launched", "workerId": "worker-aaaa1111" },
        { "op": "restart" },
        { "op": "connect" },
